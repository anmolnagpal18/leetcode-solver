# LeetCode Companion Cloud Backend Environment Variables
# Copy this file to .env and fill in your values
# WARNING: NEVER COMMIT .env TO VERSION CONTROL OR GITHUB

# ── Server Configuration ──────────────────────────────────────────────────────
PORT=3000
TELEGRAM_MODE=polling       # "polling" (recommended for 0-config 24/7) or "webhook"
AUTO_SOLVE_DAILY=false      # Set to true to automatically solve the daily challenge at 00:00 UTC

# ── Telegram Configuration (Required for Bot) ─────────────────────────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram Chat ID (from @userinfobot or message history)
TELEGRAM_CHAT_ID=

# ── AI Engine Configuration (Required for Code Generation) ────────────────────
# Free key from https://console.groq.com/keys (starts with gsk_)
GROQ_API_KEY=

# ── LeetCode Authentication (Required for Direct Submission when laptop is OFF)
# Obtain from your browser while logged into leetcode.com:
# Open DevTools (F12) -> Application/Storage -> Cookies -> https://leetcode.com
# 1. Copy the value of cookie "LEETCODE_SESSION"
# 2. Copy the value of cookie "csrftoken"
# CAUTION: Treat these like passwords. Never share or log them.
LEETCODE_SESSION=
LEETCODE_CSRF_TOKEN=

# ── GitHub Synchronization (Optional) ─────────────────────────────────────────
# Personal Access Token with "repo" scope from https://github.com/settings/tokens
GITHUB_TOKEN=
# Target repository in "owner/repo" format (e.g. yourname/leetcode-solutions)
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_FOLDER=solutions
